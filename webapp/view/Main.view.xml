							</f:layoutData>
							<f:header>
								<card:Header title="Positive Insight"/>
							</f:header>
							<f:content>
								<ScrollContainer height="14rem" vertical="true" width="100%">
									<FlexBox width="100%" renderType="Bare">
										<List growing="true" growingThreshold="3"
											items="{ path: 'tlCard>/toInsight/results', filters : [ { path : 'SubtypeId', operator : 'EQ', value1 : '0001'} ], templateShareable: true }">
											<StandardListItem title="{tlCard>Comments}" wrapping="true"/>
										</List>
									</FlexBox>
								</ScrollContainer>
							</f:content>
						</f:Card>
						<f:Card class="sapUiSmallMargin">

						<f:Card class="sapUiSmallMargin">
							<f:layoutData>
								<f:GridContainerItemLayoutData columns="{= ${device>/system/phone} ? 4 : 5 }" rows="10"/>
							</f:layoutData>
							<f:header>
								<card:Header title="Performance - 360&#176;"/>
							</f:header>
							<f:content>
								<FlexBox width="100%" renderType="Bare" justifyContent="Center" alignContent="Center">
									<viz:VizFrame id="idVizFrame360" uiConfig="{applicationSet:'fiori'}" vizType="radar" height="19rem" width="100%">
										<viz:dataset>
											<viz.data:FlattenedDataset data="{/performa}">
												<viz.data:dimensions>
													<viz.data:DimensionDefinition name="Feedback" value="{Performance Name}"/>
												</viz.data:dimensions>
												<viz.data:measures>
													<viz.data:MeasureDefinition name="Score" value="{Score}"/>
												</viz.data:measures>
											</viz.data:FlattenedDataset>
										</viz:dataset>
										<viz:feeds>
											<viz.feeds:FeedItem id='valueAxisFeed' uid="valueAxis" type="Measure" values="Score"/>
											<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Feedback"/>
										</viz:feeds>
									</viz:VizFrame>
								</FlexBox>
							</f:content>
						</f:Card>
						<f:Card class="sapUiSmallMargin">
							<f:layoutData>
								<f:GridContainerItemLayoutData columns="{= ${device>/system/phone} ? 4 : 7 }" rows="10"/>
							</f:layoutData>
							<f:header>
								<card:Header title="Aspiration"/>
							</f:header>
							<f:content>
								<ScrollContainer height="18rem" vertical="true" width="100%">
									<VBox width="97%" renderType="Bare" height="100%" class="sapUiTinyMarginBeginEnd"
										items="{ path: 'tlCard>/toAspiration/results', templateShareable: true }">
										<VBox>
											<Label text="{tlCard>Question}" design="Bold" class="sapUiSmallMarginTop" wrapping="true"/>
											<TextArea value="{tlCard>Answer}" cols="50" editable="false" width="100%" growing="true"/>
										</VBox>
									</VBox>
								</ScrollContainer>
							</f:content>
						</f:Card>
						<f:Card class="sapUiSmallMargin">

							</f:header>
							<f:content>
								<ScrollContainer height="10rem" vertical="true" width="100%">
									<FlexBox width="100%" renderType="Bare">
										<List growing="true" growingThreshold="2" items="{ path: 'tlCard>/toDevProgram/results', templateShareable: true }">
											<StandardListItem
												title="{parts: [{path: 'tlCard>TahunAngkatan'}, {path: 'tlCard>Name'}, {path: 'tlCard>SubtypeId'}], formatter:'.formatter.formatDevProgram'}"/>
										</List>
									</FlexBox>
								</ScrollContainer>
							</f:content>
						</f:Card>
						<f:Card class="sapUiSmallMargin">
							<f:layoutData>
								<f:GridContainerItemLayoutData columns="4" rows="6"/>
							</f:layoutData>
							<f:header>
								<card:Header title="PAT Record"/>
							</f:header>
							<f:content>
								<FlexBox width="100%" renderType="Bare" justifyContent="Center" alignContent="Center" class="sapUiSmallMarginBottom sapUiMediumMarginTop"
									height="6rem">
									<mchart:ColumnMicroChart id="mchartPat" size="L" press="press" allowColumnLabels="true" height="100%" tooltip="">
										<mchart:columns>
											<mchart:ColumnMicroChartData value="{path: 'tlCard>/toPerformance/Value01', formatter:'.formatter.formatToNumber'}"
												label="{tlCard>/toPerformance/Year01}" color="sapUiChartPaletteQualitativeHue3" tooltip=""
												displayValue="{parts: [{path: 'tlCard>/toPerformance/Score01'}, {path: 'tlCard>/toPerformance/Rating01'}], formatter:'.formatter.formatTextWithBrackets'}"/>
											<mchart:ColumnMicroChartData value="{path: 'tlCard>/toPerformance/Value02', formatter:'.formatter.formatToNumber'}"
												label="{tlCard>/toPerformance/Year02}" color="sapUiChartPaletteQualitativeHue2" tooltip=""
												displayValue="{parts: [{path: 'tlCard>/toPerformance/Score02'}, {path: 'tlCard>/toPerformance/Rating02'}], formatter:'.formatter.formatTextWithBrackets'}"/>
											<mchart:ColumnMicroChartData value="{path: 'tlCard>/toPerformance/Value03', formatter:'.formatter.formatToNumber'}"
												label="{tlCard>/toPerformance/Year03}" color="sapUiChartPaletteQualitativeHue1" tooltip=""
												displayValue="{parts: [{path: 'tlCard>/toPerformance/Score03'}, {path: 'tlCard>/toPerformance/Rating03'}], formatter:'.formatter.formatTextWithBrackets'}"/>
										</mchart:columns>
									</mchart:ColumnMicroChart>
								</FlexBox>
							</f:content>
						</f:Card>

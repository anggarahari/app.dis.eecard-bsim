<mvc:View controllerName="smm.hcmapp.dis.eecard3.controller.Main" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m" xmlns:semantic="sap.m.semantic" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
	xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:mchart="sap.suite.ui.microchart" xmlns:uicom="sap.suite.ui.commons"
	xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:viz.data="sap.viz.ui5.data">
	<semantic:FullscreenPage id="fullScreenPage" showFooter="false" class="sapUiResponsiveContentPadding sapUiFioriObjectPage">
		<semantic:content>
			<Panel id="pnlCard" expandable="false" expanded="true" headerText="Talent Card" width="auto" expand="onExpand">
				<headerToolbar>
					<OverflowToolbar height="3rem">
						<Title text="Employee Card"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://pdf-attachment" press="onPdfExport" text="Export to PDF" tooltip="Export to PDF"
							visible="{= !${device>/system/phone}}"/>
					</OverflowToolbar>
				</headerToolbar>
				<f:GridContainer id="grid1" class="sapUiSmallMargin" snapToRow="true" inlineBlockLayout="false" allowDenseFill="false" width="100%">
					<f:layout>
						<f:GridContainerSettings columns="12" rowSize="1.3rem" columnSize="5rem" gap="1rem"/>
					</f:layout>
					<f:layoutM>
						<f:GridContainerSettings columns="8" rowSize="1.3rem" columnSize="5rem" gap="1rem"/>
					</f:layoutM>
					<f:layoutS>
						<f:GridContainerSettings columns="6" rowSize="2.0rem" columnSize="4.75rem" gap="0.25rem"/>
					</f:layoutS>
					<f:layoutXS>
						<f:GridContainerSettings columns="4" rowSize="2.0rem" columnSize="4.75rem" gap="0.25rem"/>
					</f:layoutXS>
					<f:items>
						<f:Card id="personalDataCard" class="sapUiSmallMargin">
							<f:layoutData>
								<f:GridContainerItemLayoutData columns="4" rows="17"/>
							</f:layoutData>
							<f:header>
								<card:Header id="idPersDataCard"
									title="{parts: [{path: 'tlCard>/EmployeeName/FormattedName'}, {path: 'tlCard>/EmployeeNumber'}], formatter:'.formatter.formatEmpName'}"
									subtitle="{tlCard>/EmployeePositionLongtext}"
									iconSrc="{path: 'tlCard>/toEmployeePicture/__metadata/media_src', formatter:'.formatter.formatImageURL'}"/>
							</f:header>
							<f:content>
								<ScrollContainer height="32rem" vertical="true" width="100%">
									<form:SimpleForm layout="ResponsiveGridLayout">
										<form:content>
											<!--<core:Title text="Personal Data"/>-->
											<!--<ObjectStatus title="{parts: [{path: 'appParams>/Year'}, {value: false}], formatter:'.formatter.formatClass'}"-->
											<!--	text="{tlCard>/toProfile/TalentClassOriText}" inverted="true"-->
											<!--	state="{path: 'tlCard>/toProfile/TalentClassOri', formatter: '.formatter.getTalentClassState'}"/>-->
											<!--<ObjectStatus title="{parts: [{path: 'appParams>/Year'}, {value: true}], formatter:'.formatter.formatClass'}"-->
											<!--	text="{tlCard>/toProfile/TalentClassCaliText}" inverted="true"-->
											<!--	state="{path: 'tlCard>/toProfile/TalentClassCali', formatter: '.formatter.getTalentClassState'}"/>-->
											<Label text="Age"/>
											<Text text="{path: 'tlCard>/Age', formatter:'.formatter.formatAge'}"/>
											<Label text="Years of Service in SMM"/>
											<Text text="{parts: [{path: 'tlCard>/Yos'}, {path: 'tlCard>/HireDate'}], formatter:'.formatter.formatYos'}"/>
											<Label text="Years of Service in Current Position"/>
											<Text text="{parts: [{path: 'tlCard>/YosPosition'}, {path: 'tlCard>/PositionDate'}], formatter:'.formatter.formatYosPos'}"/>
											<Label text="Job Grade / PS Level"/>
											<Text text="{parts: [{path: 'tlCard>/PayScaleGroup'}, {path: 'tlCard>/PayScaleLevel'}], formatter:'.formatter.formatPayScale'}"/>
											<!--<core:Title text="Corporate Data"/>-->
											<Label text="Directorate"/>
											<Text text="{tlCard>/DirectorateText}"/>
											<Label text="Division"/>
											<Text text="{tlCard>/DivisionText}"/>
											<Label text="Department"/>
											<Text text="{tlCard>/DepartmentText}"/>
											<Label text="Organization Structure"/>
											<Text text="{tlCard>/BusUnitText}"/>
											<Label text="Group"/>
											<Text text="{tlCard>/BusinessAreaText}"/>
											<Label text="Last Promotion"/>
											<Text id="txLastPromo"
												text="{ path: 'tlCard>/PromotionDate', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, style: 'long' }, constraints: { displayFormat: 'Date' } }"/>
											<Label text="Last Rotation"/>
											<Text id="txLastRotat"
												text="{ path: 'tlCard>/RotationDate', type: 'sap.ui.model.type.Date', formatOptions: { UTC: true, style: 'long' }, constraints: { displayFormat: 'Date' } }"/>
											<!--<Text text="{tlCard>/RotationPositionText}"/>-->
											<Label text="Position Before Current"/>
											<Text text="{tlCard>/BeforePositionText}"/>
										</form:content>
									</form:SimpleForm>
								</ScrollContainer>
							</f:content>
						</f:Card>
						<f:Card class="sapUiSmallMargin">
							<f:layoutData>
								<f:GridContainerItemLayoutData columns="4" rows="17"/>
							</f:layoutData>
							<f:header>
								<card:Header title="Knowledge"/>
							</f:header>
							<f:content>
								<VBox>
									<ScrollContainer height="8rem" vertical="true" width="100%">
										<FlexBox id="mchartStemBox" width="100%" renderType="Bare" justifyContent="Center">
											<mchart:ComparisonMicroChart id="mchartStem" size="M" view="Normal" class="sapUiRFLContainer sapUiSmallMargin" press="press"
												shrinkable="true" data="{ path: 'stem>/data', templateShareable: true }"
												colorPalette="sapUiChartPaletteQualitativeHue1, sapUiChartPaletteQualitativeHue2, sapUiChartPaletteQualitativeHue3, sapUiChartPaletteQualitativeHue4, sapUiChartPaletteQualitativeHue5, sapUiChartPaletteQualitativeHue6">
												<mchart:data>
													<mchart:ComparisonMicroChartData title="{stem>StemText}" value="{stem>Count}"/>
												</mchart:data>
											</mchart:ComparisonMicroChart>
										</FlexBox>
									</ScrollContainer>
									<ScrollContainer height="14.5rem" vertical="true" width="100%">
										<FlexBox width="100%" renderType="Bare">
											<List growing="true" growingThreshold="3"
												items="{ path: 'training>/data', sorter: { path: 'JenisText', descending: false, group: true }, groupHeaderFactory: '.getGroupHeader' }">
												<StandardListItem
													title="{parts: [{path: 'training>TrainingName'}, {path: 'training>Tahun'}], formatter:'.formatter.formatTextWithBrackets'}"/>
											</List>
										</FlexBox>
									</ScrollContainer>
									<ScrollContainer height="11rem" vertical="true" width="100%">
										<FlexBox width="100%" renderType="Bare">
											<List growing="true" growingThreshold="3"
												items="{ path: 'tlCard>/toEducation/results', sorter: { path: 'Category', descending: false, group: '.grouperEdu' }, groupHeaderFactory: '.getGroupHeader', templateShareable: true }">
												<StandardListItem
													title="{parts: [{path: 'tlCard>EstablishmentText'}, {path: 'tlCard>StudyBranch1Text'}, {path: 'tlCard>StudyBranch2Text'}, {path: 'tlCard>EndDate'}], formatter:'.formatter.formatEdu'}"
													description="{tlCard>Institute}"/>
											</List>
										</FlexBox>
									</ScrollContainer>
								</VBox>
							</f:content>
						</f:Card>
